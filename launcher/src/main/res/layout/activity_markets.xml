<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dash_bg"
    android:orientation="horizontal"
    android:paddingStart="44dp"
    android:paddingTop="24dp"
    android:paddingEnd="44dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:id="@+id/mk_list"
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView style="@style/Kicker" android:text="@string/markets" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mk_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A6FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mk_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/mk_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="5dp"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.mtv.launcher.SparklineView
            android:id="@+id/mk_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/mk_ranges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/mk_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
