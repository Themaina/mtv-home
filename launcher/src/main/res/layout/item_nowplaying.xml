<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="7dp">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/np_bg"
        android:focusable="true"
        android:foreground="@drawable/tile_bg"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/np_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View android:id="@+id/eq1" android:layout_width="3dp" android:layout_height="14dp" android:background="#FFFF4E6A" />
                <View android:id="@+id/eq2" android:layout_width="3dp" android:layout_height="14dp" android:layout_marginStart="2dp" android:background="#FFFF4E6A" />
                <View android:id="@+id/eq3" android:layout_width="3dp" android:layout_height="14dp" android:layout_marginStart="2dp" android:background="#FFFF4E6A" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/np_art"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/card_bg"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/np_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/np_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bar_track">

            <View
                android:id="@+id/np_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFF4E6A" />
        </FrameLayout>

        <TextView
            android:id="@+id/np_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#99FFFFFF"
            android:textSize="10.5sp" />
    </LinearLayout>
</FrameLayout>
