<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/f1_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="22dp"
        android:paddingEnd="32dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/f1_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical">

            <TextView android:id="@+id/f1_round" style="@style/Kicker" />

            <TextView
                android:id="@+id/f1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/f1_where"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A6FFFFFF"
                android:textSize="12sp" />

            <com.mtv.launcher.CountdownView
                android:id="@+id/f1_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/f1_race_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D9FFFFFF"
                android:textSize="12sp" />

            <TextView style="@style/SectionTitle" android:text="@string/f1_weekend" />

            <LinearLayout
                android:id="@+id/f1_sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/f1_watch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:text="@string/f1_watch"
                android:textColor="@color/pill_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/f1_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/tab_drivers" style="@style/Tab" android:text="@string/f1_drivers" />
                <TextView android:id="@+id/tab_teams" style="@style/Tab" android:text="@string/f1_teams" />
                <TextView android:id="@+id/tab_season" style="@style/Tab" android:text="@string/f1_season" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/f1_list_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:focusable="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/f1_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/f1_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#A6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
